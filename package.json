{
    "name": "@billkit-io/billkit",
    "version": "0.0.5",
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/billkit-io/billkit-node.git"
    },
    "license": "MIT",
    "type": "commonjs",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.mts",
                "default": "./dist/esm/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            },
            "default": "./dist/cjs/index.js"
        },
        "./addons": {
            "import": {
                "types": "./dist/esm/api/resources/addons/exports.d.mts",
                "default": "./dist/esm/api/resources/addons/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/addons/exports.d.ts",
                "default": "./dist/cjs/api/resources/addons/exports.js"
            },
            "default": "./dist/cjs/api/resources/addons/exports.js"
        },
        "./assignments": {
            "import": {
                "types": "./dist/esm/api/resources/assignments/exports.d.mts",
                "default": "./dist/esm/api/resources/assignments/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/assignments/exports.d.ts",
                "default": "./dist/cjs/api/resources/assignments/exports.js"
            },
            "default": "./dist/cjs/api/resources/assignments/exports.js"
        },
        "./billing": {
            "import": {
                "types": "./dist/esm/api/resources/billing/exports.d.mts",
                "default": "./dist/esm/api/resources/billing/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/billing/exports.d.ts",
                "default": "./dist/cjs/api/resources/billing/exports.js"
            },
            "default": "./dist/cjs/api/resources/billing/exports.js"
        },
        "./entitlements": {
            "import": {
                "types": "./dist/esm/api/resources/entitlements/exports.d.mts",
                "default": "./dist/esm/api/resources/entitlements/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/entitlements/exports.d.ts",
                "default": "./dist/cjs/api/resources/entitlements/exports.js"
            },
            "default": "./dist/cjs/api/resources/entitlements/exports.js"
        },
        "./contracts": {
            "import": {
                "types": "./dist/esm/api/resources/contracts/exports.d.mts",
                "default": "./dist/esm/api/resources/contracts/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/contracts/exports.d.ts",
