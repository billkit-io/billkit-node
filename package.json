            },
            "default": "./dist/cjs/api/resources/contracts/exports.js"
        },
        "./invoices": {
            "import": {
                "types": "./dist/esm/api/resources/invoices/exports.d.mts",
                "default": "./dist/esm/api/resources/invoices/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/invoices/exports.d.ts",
                "default": "./dist/cjs/api/resources/invoices/exports.js"
            },
            "default": "./dist/cjs/api/resources/invoices/exports.js"
        },
        "./apiKeys": {
            "import": {
                "types": "./dist/esm/api/resources/apiKeys/exports.d.mts",
                "default": "./dist/esm/api/resources/apiKeys/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/apiKeys/exports.d.ts",
